# Copy to .env and uncomment what you need: cp .env.example .env
# .env is gitignored. Variables already set in your shell take precedence.
# An empty or commented-out value means the default shown.
# Plain KEY=value lines only, no quotes: the Makefile reads this file too.

# --- Target: the model under test -------------------------------------------
# --local: a model on the local OpenAI-compatible server (Ollama, llama-server).
# Default: the first chat model the server lists; set it explicitly.
# EVALS_LOCAL_MODEL=llama3.2:latest
# Server URL. Default: probe Ollama (localhost:11434), then llama-server (8080).
# LOCAL_BASE_URL=http://localhost:11434/v1

# --live: a hosted model, as an Inspect model name.
# EVALS_MODEL=openai/gpt-6-luna
# The Agents SDK model with --live in lessons 14-18. Default: EVALS_MODEL
# without its provider prefix.
# EVALS_AGENT_MODEL=gpt-6-luna
# Key for openai/ models. Other providers read their own key variable.
# OPENAI_API_KEY=

# --- Other roles (ADR 0009) --------------------------------------------------
# local/<name> is a model on the local server; anything else an Inspect name.
# Default: follow the target's mode (scripted, --local, or --live).
# The judge or classifier in lessons 07, 11, 12.
# EVALS_JUDGE_MODEL=local/mistral-nemo:12b
# The attacker in lesson 22.
# EVALS_ATTACKER_MODEL=local/mistral-nemo:12b

# --- Lesson settings ---------------------------------------------------------
# Rounds per goal in lesson 22's attacker loop.
# EVALS_ATTACK_ROUNDS=5
# Haystack length in lesson 19; keep it within the model's context window.
# EVALS_HAYSTACK_WORDS=1500

# --- Outputs and red-teaming -------------------------------------------------
# Inspect eval logs.
# INSPECT_LOG_DIR=out/inspect-logs
# Lesson 21's score file.
# EVALS_SCORES=out/scores.json
# Probes for make redteam (garak --spec syntax).
# GARAK_SPEC=probes.promptinject.HijackHateHumans
